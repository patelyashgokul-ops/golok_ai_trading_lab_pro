<odoo>
    <record id="view_portfolio_compare" model="ir.ui.view">
        <field name="name">golok.lab.portfolio.wizard.compare</field><field name="model">golok.lab.portfolio.wizard</field>
        <field name="inherit_id" ref="view_portfolio_wizard"/>
        <field name="arch" type="xml"><xpath expr="//button[@name='action_run']" position="after">
            <button name="action_compare" type="object" string="Compare Five Strategies" class="btn-secondary"/>
            <button name="action_walk_forward" type="object" string="Walk-forward Validation" class="btn-secondary"/>
            <button name="action_seal" type="object" string="Seal Final Holdout" invisible="not training_id"/>
        </xpath><xpath expr="//field[@name='strategy']" position="after"><field name="target_policy"/><field name="training_id" options="{'no_create': True}"/></xpath></field>
    </record>
    <record id="view_holdout_form" model="ir.ui.view">
        <field name="name">golok.lab.holdout.form</field><field name="model">golok.lab.holdout</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <header><button name="action_consume" string="Consume Final Holdout" type="object"
                invisible="result_id" groups="golok_ai_trading_lab_pro.group_risk" class="btn-primary"/></header>
            <sheet><group><field name="training_id"/><field name="starts"/><field name="ends"/>
            <field name="sealed_by"/><field name="consumed_by"/><field name="consumed_at"/>
            <field name="result_id"/><field name="fingerprint"/></group><field name="specification"/></sheet></form></field>
    </record>
    <record id="action_holdout" model="ir.actions.act_window"><field name="name">Sealed Holdouts</field>
        <field name="res_model">golok.lab.holdout</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_holdout" name="Sealed Holdouts" parent="menu_lab" action="action_holdout" sequence="98"/>
    <record id="view_source_review_form" model="ir.ui.view">
        <field name="name">golok.lab.source.review.form</field><field name="model">golok.lab.source.review</field>
        <field name="arch" type="xml"><form edit="0" delete="0" duplicate="0"><sheet>
            <group><group><field name="provider"/><field name="terms_url"/><field name="documentation"/>
                <field name="evidence"/><field name="expires"/><field name="storage_policy"/></group>
                <group><field name="purpose"/><field name="restrictions"/><field name="create_uid" readonly="1"/>
                <field name="create_date" readonly="1"/></group></group>
            <group string="Permissions" col="6"><field name="query"/><field name="display"/><field name="persist"/>
                <field name="automatic"/><field name="backtest"/><field name="optimize"/><field name="fit"/>
                <field name="live"/><field name="export"/></group>
        </sheet></form></field>
    </record>
    <record id="view_daily_import_form" model="ir.ui.view">
        <field name="name">golok.lab.daily.import.form</field><field name="model">golok.lab.daily.import</field>
        <field name="arch" type="xml"><form edit="0" delete="0" duplicate="0"><sheet><group>
            <field name="source"/><field name="day"/><field name="calendar_id"/>
            <field name="upload" required="not id" invisible="id"/>
            <field name="review_id" readonly="1" invisible="not id"/><field name="digest" readonly="1" invisible="not id"/>
            <field name="status" readonly="1" invisible="not id"/><field name="count" readonly="1" invisible="not id"/>
            <field name="details" readonly="1" invisible="not id"/>
        </group></sheet></form></field>
    </record>
    <record id="view_daily_import_list" model="ir.ui.view">
        <field name="name">golok.lab.daily.import.list</field><field name="model">golok.lab.daily.import</field>
        <field name="arch" type="xml"><list edit="0" delete="0"><field name="source"/><field name="day"/>
            <field name="status"/><field name="count"/><field name="digest"/></list></field>
    </record>
    <record id="action_source_reviews" model="ir.actions.act_window"><field name="name">Source Authorizations</field>
        <field name="res_model">golok.lab.source.review</field><field name="view_mode">list,form</field></record>
    <record id="action_daily_imports" model="ir.actions.act_window"><field name="name">End-of-day File Imports</field>
        <field name="res_model">golok.lab.daily.import</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_source_reviews" name="Source Authorizations" parent="menu_lab" action="action_source_reviews" groups="group_admin" sequence="96"/>
    <menuitem id="menu_daily_imports" name="End-of-day File Imports" parent="menu_lab" action="action_daily_imports" groups="group_admin" sequence="97"/>
</odoo>
