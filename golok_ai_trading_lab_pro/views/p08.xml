<odoo>
    <record id="view_calendar_generate_fixture" model="ir.ui.view">
        <field name="name">golok.lab.calendar.fixture.generation</field><field name="model">golok.lab.calendar</field>
        <field name="inherit_id" ref="view_calendar_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="before"><header>
            <button name="action_generate_fixture" type="object" string="Generate Deterministic Fixture"
                    invisible="not id or verification != 'fixture'" groups="golok_ai_trading_lab_pro.group_admin"/>
        </header></xpath></field>
    </record>
    <record id="view_dataset_fixture_lineage" model="ir.ui.view">
        <field name="name">golok.lab.dataset.fixture.lineage</field><field name="model">golok.lab.dataset</field>
        <field name="inherit_id" ref="view_dataset"/>
        <field name="arch" type="xml"><field name="origin" position="after">
            <field name="lineage_status" readonly="1"/>
            <field name="fixture_version" readonly="1" invisible="not fixture_version"/>
            <field name="fixture_seed" readonly="1" invisible="not fixture_version"/>
            <field name="fixture_digest" readonly="1" invisible="not fixture_version"/>
            <field name="integrity_conflict" readonly="1" invisible="not integrity_conflict"/>
        </field></field>
    </record>
    <record id="view_review_lineage" model="ir.ui.view">
        <field name="name">golok.lab.source.review.lineage</field><field name="model">golok.lab.source.review</field>
        <field name="inherit_id" ref="view_source_review_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before"><header>
                <button name="action_revoke" type="object" string="Revoke Authorization" invisible="not id or revoked_at"
                        confirm="Revoke application access to data bound to this review?"/>
            </header></xpath>
            <field name="expires" position="after"><field name="upstream"/><field name="retain_until"/>
                <field name="lifecycle" readonly="1"/>
                <field name="revoked_at" readonly="1"/></field>
            <field name="display" position="after"><field name="research"/><field name="raw_share_ohlcv"/></field>
        </field>
    </record>
    <record id="view_daily_normalize" model="ir.ui.view">
        <field name="name">golok.lab.daily.import.normalize</field><field name="model">golok.lab.daily.import</field>
        <field name="inherit_id" ref="view_daily_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before"><header>
                <button name="action_normalize" type="object" string="Normalize to Research Datasets"
                        class="btn-primary" invisible="not id or status != 'accepted'"/>
            </header></xpath>
            <field name="count" position="after"><field name="normalized_dataset_ids" widget="many2many_tags" readonly="1"/></field>
            <field name="calendar_id" position="after">
                <field name="corrects_id" readonly="id" invisible="id and not corrects_id"
                       domain="[('source','=',source),('day','=',day),('calendar_id','=',calendar_id),('status','=','accepted')]"/>
                <field name="correction_evidence" readonly="id" invisible="not corrects_id" required="corrects_id"/>
            </field>
        </field>
    </record>
    <record id="view_session_watch_list" model="ir.ui.view">
        <field name="name">golok.lab.session.watch.list</field><field name="model">golok.lab.session.watch</field>
        <field name="arch" type="xml"><list delete="0"><field name="dataset_id"/><field name="active"/></list></field>
    </record>
    <record id="view_session_watch_form" model="ir.ui.view">
        <field name="name">golok.lab.session.watch.form</field><field name="model">golok.lab.session.watch</field>
        <field name="arch" type="xml"><form delete="0"><header>
            <button name="action_check_now" type="object" string="Check Session Now" invisible="not id or not active"/>
        </header><sheet>
            <group><field name="dataset_id" domain="[('origin','=','synthetic'),('calendar_id.verification','=','fixture')]"/>
                <field name="active"/></group>
            <field name="event_ids" readonly="1"><list><field name="day"/><field name="phase"/>
                <field name="state"/><field name="observation_count"/><field name="summary"/></list></field>
        </sheet></form></field>
    </record>
    <record id="view_session_event_list" model="ir.ui.view">
        <field name="name">golok.lab.session.event.list</field><field name="model">golok.lab.session.event</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="day"/><field name="observed_at"/><field name="phase"/><field name="state"/>
            <field name="mode"/><field name="recovered"/><field name="observation_count"/><field name="summary"/><field name="run_id"/>
        </list></field>
    </record>
    <record id="action_session_watch" model="ir.actions.act_window">
        <field name="name">Fixture Research Schedules</field><field name="res_model">golok.lab.session.watch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_session_event" model="ir.actions.act_window">
        <field name="name">Daily Research Operations</field><field name="res_model">golok.lab.session.event</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_session_watch" name="Research Schedules" parent="menu_lab" action="action_session_watch"
              groups="group_admin" sequence="99"/>
    <menuitem id="menu_session_event" name="Daily Research Operations" parent="menu_lab" action="action_session_event" sequence="100"/>
    <record id="view_source_comparison_list" model="ir.ui.view">
        <field name="name">golok.lab.source.comparison.list</field><field name="model">golok.lab.source.comparison</field>
        <field name="arch" type="xml"><list edit="0" delete="0"><field name="left_id"/><field name="right_id"/>
            <field name="close_at"/><field name="outcome"/><field name="tolerance"/></list></field>
    </record>
    <record id="view_source_comparison_form" model="ir.ui.view">
        <field name="name">golok.lab.source.comparison.form</field><field name="model">golok.lab.source.comparison</field>
        <field name="arch" type="xml"><form edit="0" delete="0"><sheet><group><field name="left_id"/><field name="right_id"/>
            <field name="close_at"/><field name="outcome"/><field name="differences"/><field name="upstreams"/>
            <field name="tolerance"/></group></sheet></form></field>
    </record>
    <record id="action_source_comparison" model="ir.actions.act_window">
        <field name="name">Compare Market Data Sources</field><field name="res_model">golok.lab.source.comparison</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_source_comparison" name="Compare Sources" parent="menu_lab" action="action_source_comparison"
              groups="group_admin" sequence="101"/>
    <data noupdate="1">
        <record id="cron_session_research" model="ir.cron">
            <field name="name">Golok: session research and historical queue</field>
            <field name="model_id" ref="model_golok_lab_session_watch"/>
            <field name="state">code</field><field name="code">model._cron_dispatch()</field>
            <field name="interval_number">2</field><field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/><field name="active" eval="True"/>
        </record>
    </data>
</odoo>
