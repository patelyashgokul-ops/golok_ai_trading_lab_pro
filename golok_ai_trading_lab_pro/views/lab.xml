<odoo>
    <record id="view_instruments" model="ir.ui.view">
        <field name="name">golok.lab.instrument.list</field>
        <field name="model">golok.lab.instrument</field>
        <field name="arch" type="xml">
            <list><field name="exchange"/><field name="symbol"/><field name="name"/><field name="company_id"/></list>
        </field>
    </record>
    <record id="view_instrument" model="ir.ui.view">
        <field name="name">golok.lab.instrument.form</field>
        <field name="model">golok.lab.instrument</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/><field name="exchange" readonly="id"/><field name="symbol" readonly="id"/>
                <field name="company_id" readonly="id"/><field name="active"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="view_datasets" model="ir.ui.view">
        <field name="name">golok.lab.dataset.list</field>
        <field name="model">golok.lab.dataset</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="instrument_id"/><field name="interval"/><field name="origin"/><field name="source"/><field name="company_id"/></list>
        </field>
    </record>
    <record id="view_dataset" model="ir.ui.view">
        <field name="name">golok.lab.dataset.form</field>
        <field name="model">golok.lab.dataset</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/><field name="company_id" readonly="id"/>
                <field name="instrument_id" readonly="id"/><field name="source" readonly="id"/>
                <field name="origin" readonly="id"/><field name="interval" readonly="id"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="view_candles" model="ir.ui.view">
        <field name="name">golok.lab.candle.list</field>
        <field name="model">golok.lab.candle</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="dataset_id"/><field name="close_time"/><field name="origin"/>
                <field name="open_price"/><field name="high_price"/><field name="low_price"/>
                <field name="close_price"/><field name="volume"/><field name="quality"/>
                <field name="ingested_at" optional="hide"/><field name="processing_version" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_runs" model="ir.ui.view">
        <field name="name">golok.lab.run.list</field>
        <field name="model">golok.lab.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="dataset_id"/><field name="as_of"/><field name="origin"/><field name="last_close"/>
                <field name="bar_count"/><field name="gap_count"/><field name="decision"/>
            </list>
        </field>
    </record>
    <record id="view_run" model="ir.ui.view">
        <field name="name">golok.lab.run.form</field>
        <field name="model">golok.lab.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group><group>
                        <field name="dataset_id"/><field name="origin"/><field name="as_of"/>
                        <field name="first_close"/><field name="last_close"/>
                    </group><group>
                        <field name="decision"/><field name="bar_count"/><field name="gap_count"/><field name="engine_version"/>
                        <field name="input_digest"/>
                    </group></group>
                    <group><field name="reason"/><field name="evidence_text"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_import" model="ir.ui.view">
        <field name="name">golok.lab.import.form</field>
        <field name="model">golok.lab.import</field>
        <field name="arch" type="xml">
            <form><group><field name="dataset_id"/><field name="filename" invisible="1"/>
                <field name="upload" filename="filename"/>
            </group><footer>
                <button name="action_import" type="object" string="Import candles" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer></form>
        </field>
    </record>
    <record id="view_research" model="ir.ui.view">
        <field name="name">golok.lab.research.form</field>
        <field name="model">golok.lab.research</field>
        <field name="arch" type="xml">
            <form><group><field name="dataset_id"/><field name="as_of"/></group>
                <footer>
                    <button name="action_research" type="object" string="Run research" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_overview" model="ir.actions.client">
        <field name="name">Research Overview</field>
        <field name="tag">golok_lab.overview</field>
    </record>
    <record id="action_instruments" model="ir.actions.act_window">
        <field name="name">Instruments</field><field name="res_model">golok.lab.instrument</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_datasets" model="ir.actions.act_window">
        <field name="name">Datasets</field><field name="res_model">golok.lab.dataset</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_candles" model="ir.actions.act_window">
        <field name="name">Candles</field><field name="res_model">golok.lab.candle</field><field name="view_mode">list</field>
    </record>
    <record id="action_runs" model="ir.actions.act_window">
        <field name="name">Research history</field><field name="res_model">golok.lab.run</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_import" model="ir.actions.act_window">
        <field name="name">Import historical CSV</field><field name="res_model">golok.lab.import</field><field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="action_research" model="ir.actions.act_window">
        <field name="name">Run historical research</field><field name="res_model">golok.lab.research</field><field name="view_mode">form</field><field name="target">new</field>
    </record>
    <menuitem id="menu_lab" name="Trading Lab" action="action_overview" groups="group_viewer"/>
    <menuitem id="menu_overview" name="Overview" parent="menu_lab" action="action_overview" sequence="10"/>
    <menuitem id="menu_instruments" name="Instruments" parent="menu_lab" action="action_instruments" sequence="20"/>
    <menuitem id="menu_datasets" name="Datasets" parent="menu_lab" action="action_datasets" sequence="30"/>
    <menuitem id="menu_import" name="Import CSV" parent="menu_lab" action="action_import" groups="group_analyst" sequence="40"/>
    <menuitem id="menu_candles" name="Candles" parent="menu_lab" action="action_candles" sequence="50"/>
    <menuitem id="menu_research" name="Run Research" parent="menu_lab" action="action_research" groups="group_analyst" sequence="60"/>
    <menuitem id="menu_runs" name="Research History" parent="menu_lab" action="action_runs" sequence="70"/>
</odoo>
