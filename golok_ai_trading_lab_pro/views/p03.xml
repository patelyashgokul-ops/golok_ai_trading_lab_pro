<odoo>
    <record id="view_mapping_list" model="ir.ui.view">
        <field name="name">golok.lab.mapping.list</field>
        <field name="model">golok.lab.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="symbol"/><field name="exchange"/><field name="provider"/><field name="token"/>
                <field name="starts"/><field name="ends"/><field name="listing_status"/><field name="verification"/>
                <field name="instrument_id"/><field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_mapping_form" model="ir.ui.view">
        <field name="name">golok.lab.mapping.form</field>
        <field name="model">golok.lab.mapping</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0" duplicate="0"><sheet>
                <group>
                    <group><field name="instrument_id"/><field name="symbol"/><field name="exchange" invisible="not id"/>
                        <field name="provider"/><field name="token"/><field name="segment"/><field name="isin"/><field name="sector"/></group>
                    <group><field name="starts"/><field name="ends"/><field name="listing_status"/><field name="tick"/>
                        <field name="lot"/><field name="source"/><field name="revision"/><field name="verification"/></group>
                </group>
            </sheet></form>
        </field>
    </record>
    <record id="view_mapping_search" model="ir.ui.view">
        <field name="name">golok.lab.mapping.search</field>
        <field name="model">golok.lab.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="symbol"/><field name="token"/><field name="instrument_id"/><field name="provider"/>
                <filter name="nse" string="NSE" domain="[('exchange','=','NSE')]"/>
                <filter name="bse" string="BSE" domain="[('exchange','=','BSE')]"/>
                <separator/>
                <filter name="historical" string="Dated end" domain="[('ends','!=',False)]"/>
                <filter name="restricted" string="Suspended or delisted" domain="[('listing_status','!=','listed')]"/>
            </search>
        </field>
    </record>
    <record id="action_mapping" model="ir.actions.act_window">
        <field name="name">Instrument Mappings</field><field name="res_model">golok.lab.mapping</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_corporate_list" model="ir.ui.view">
        <field name="name">golok.lab.corporate.action.list</field>
        <field name="model">golok.lab.corporate.action</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="instrument_id"/><field name="kind"/><field name="effective"/><field name="published_at"/><field name="revision"/></list>
        </field>
    </record>
    <record id="view_corporate_form" model="ir.ui.view">
        <field name="name">golok.lab.corporate.action.form</field>
        <field name="model">golok.lab.corporate.action</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0" duplicate="0"><sheet><group>
                <group><field name="name"/><field name="company_id"/><field name="instrument_id"/><field name="kind"/><field name="effective"/></group>
                <group><field name="published_at"/><field name="source"/><field name="revision"/>
                    <field name="numerator" invisible="kind not in ('split','bonus')"/><field name="denominator" invisible="kind not in ('split','bonus')"/></group>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_corporate" model="ir.actions.act_window">
        <field name="name">Corporate Actions</field><field name="res_model">golok.lab.corporate.action</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_dataset_mapping" model="ir.ui.view">
        <field name="name">golok.lab.dataset.form.mapping</field><field name="model">golok.lab.dataset</field>
        <field name="inherit_id" ref="view_dataset"/>
        <field name="arch" type="xml">
            <field name="calendar_id" position="after">
                <field name="mapping_id" readonly="id" domain="[('instrument_id','=',instrument_id)]"/>
            </field>
        </field>
    </record>
    <menuitem id="menu_mapping" name="Instrument Mappings" parent="menu_lab" action="action_mapping" sequence="81"/>
    <menuitem id="menu_corporate" name="Corporate Actions" parent="menu_lab" action="action_corporate" sequence="82"/>
    <data noupdate="1">
        <record id="strategy_st01_p03" model="golok.lab.strategy">
            <field name="name">ST-01 Opening Range Breakout</field>
            <field name="code">ST-01</field><field name="version">multi-1</field><field name="state">research</field>
        </record>
    </data>
    <record id="view_tariff_form" model="ir.ui.view">
        <field name="name">golok.lab.tariff.form</field><field name="model">golok.lab.tariff</field>
        <field name="arch" type="xml"><form edit="0" delete="0" duplicate="0"><sheet>
            <group><field name="name"/><field name="company_id"/><field name="lines"/></group>
        </sheet></form></field>
    </record>
    <record id="action_tariff" model="ir.actions.act_window">
        <field name="name">Hypothetical Tariffs</field><field name="res_model">golok.lab.tariff</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_experiment_list" model="ir.ui.view">
        <field name="name">golok.lab.experiment.list</field><field name="model">golok.lab.experiment</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="dataset_id"/><field name="strategy_id"/><field name="starts"/><field name="ends"/>
            <field name="status"/><field name="candidate_count"/><field name="trade_count"/>
        </list></field>
    </record>
    <record id="view_experiment_form" model="ir.ui.view">
        <field name="name">golok.lab.experiment.form</field><field name="model">golok.lab.experiment</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0" duplicate="0"><sheet>
            <group>
                <group><field name="dataset_id"/><field name="strategy_id"/><field name="tariff_id"/><field name="fingerprint"/></group>
                <group><field name="status"/><field name="starts"/><field name="ends"/><field name="trade_count"/><field name="candidate_count"/></group>
            </group>
            <notebook>
                <page string="Replay Results"><field name="result" nolabel="1"/></page>
                <page string="Frozen Specification"><field name="specification" nolabel="1"/></page>
            </notebook>
        </sheet></form></field>
    </record>
    <record id="action_experiment" model="ir.actions.act_window">
        <field name="name">Synthetic Experiments</field><field name="res_model">golok.lab.experiment</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_experiment_wizard" model="ir.ui.view">
        <field name="name">golok.lab.experiment.wizard.form</field><field name="model">golok.lab.experiment.wizard</field>
        <field name="arch" type="xml"><form string="Run Synthetic Experiment">
            <group>
                <field name="dataset_id" domain="[('origin','=','synthetic'),('calendar_id','!=',False),('quarantined','=',False)]"/>
                <field name="strategy_id"/><field name="tariff_id"/><field name="starts"/><field name="ends"/><field name="capital"/><field name="tick"/>
            </group>
            <footer><button name="action_run" type="object" string="Run Synthetic Experiment" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/></footer>
        </form></field>
    </record>
    <record id="action_experiment_wizard" model="ir.actions.act_window">
        <field name="name">Run Synthetic Experiment</field><field name="res_model">golok.lab.experiment.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <menuitem id="menu_tariff" name="Hypothetical Tariffs" parent="menu_lab" action="action_tariff" sequence="83"/>
    <menuitem id="menu_experiment" name="Experiments" parent="menu_lab" action="action_experiment" sequence="84"/>
    <menuitem id="menu_experiment_wizard" name="Run Experiment" parent="menu_lab" action="action_experiment_wizard" sequence="85" groups="group_analyst"/>
    <record id="view_findings_form" model="ir.ui.view">
        <field name="name">golok.lab.findings.form</field><field name="model">golok.lab.findings</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet>
            <group><field name="run_id"/><field name="dataset_id"/><field name="instrument_id"/>
                <field name="cutoff"/><field name="input_digest"/><field name="calculation_version"/><field name="elapsed_ms"/></group>
            <field name="findings" nolabel="1"/>
        </sheet></form></field>
    </record>
    <record id="view_run_findings" model="ir.ui.view">
        <field name="name">golok.lab.run.form.findings</field><field name="model">golok.lab.run</field>
        <field name="inherit_id" ref="view_run"/>
        <field name="arch" type="xml"><sheet position="before">
            <header><button name="action_supplemental_findings" type="object" string="Run Supplemental Findings"
                            groups="golok_ai_trading_lab_pro.group_analyst"/></header>
        </sheet></field>
    </record>
    <record id="view_provider_setup" model="ir.ui.view">
        <field name="name">golok.lab.provider.setup.form</field><field name="model">golok.lab.provider.setup</field>
        <field name="arch" type="xml"><form string="SmartAPI Diagnostics">
            <p>Configure credentials on the Odoo host. Confirm that the owner has approved read-only access and registered its egress IP.</p>
            <group><field name="status"/><field name="details"/><field name="checked_at"/></group>
            <footer><button name="action_check_configuration" type="object" string="Check Local Configuration" class="btn-primary"/>
                <button name="action_test_authentication" type="object" string="Test Authorized Authentication" class="btn-secondary"/>
                <button string="Close" special="cancel" class="btn-secondary"/></footer>
        </form></field>
    </record>
    <record id="action_provider_setup" model="ir.actions.act_window">
        <field name="name">SmartAPI Diagnostics</field><field name="res_model">golok.lab.provider.setup</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <menuitem id="menu_provider_setup" name="SmartAPI Diagnostics" parent="menu_lab" action="action_provider_setup" sequence="86" groups="group_admin"/>
</odoo>
