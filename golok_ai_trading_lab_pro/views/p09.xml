<odoo>
    <record id="view_session_watch_cycles" model="ir.ui.view">
        <field name="name">golok.lab.session.watch.cycles</field>
        <field name="model">golok.lab.session.watch</field>
        <field name="inherit_id" ref="view_session_watch_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after"><field name="cycle_minutes"/></field>
            <field name="event_ids" position="after">
                <field name="cycle_ids" readonly="1">
                    <list><field name="observation_at"/><field name="cutoff"/><field name="state"/>
                        <field name="failure_reason"/></list>
                </field>
                <field name="gap_ids" readonly="1">
                    <list><field name="day"/><field name="starts_at"/><field name="ends_at"/>
                        <field name="resumed_at"/><field name="interval_minutes"/><field name="missed"/></list>
                </field>
            </field>
        </field>
    </record>
    <record id="view_research_cycle_list" model="ir.ui.view">
        <field name="name">golok.lab.research.cycle.list</field>
        <field name="model">golok.lab.research.cycle</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="day"/><field name="dataset_id"/><field name="phase"/><field name="observation_at"/>
            <field name="cutoff"/><field name="processed_at"/><field name="state"/><field name="failure_reason"/>
        </list></field>
    </record>
    <record id="view_research_cycle_form" model="ir.ui.view">
        <field name="name">golok.lab.research.cycle.form</field>
        <field name="model">golok.lab.research.cycle</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <sheet><group><field name="day"/><field name="dataset_id"/><field name="phase"/><field name="state"/>
                <field name="observation_at"/><field name="available_at"/><field name="cutoff"/>
                <field name="processed_at"/><field name="elapsed_ms"/><field name="missed_intervals"/>
                <field name="failure_reason"/><field name="run_id"/>
            </group><field name="candidate_ids"><list><field name="lifecycle"/><field name="reason"/>
                <field name="input_digest"/><field name="engine_version"/></list></field></sheet>
        </form></field>
    </record>
    <record id="action_research_cycles" model="ir.actions.act_window">
        <field name="name">Fixture Research Cycles</field>
        <field name="res_model">golok.lab.research.cycle</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_research_cycles" name="Fixture Research Cycles" parent="menu_lab"
              action="action_research_cycles" sequence="103"/>
    <record id="view_research_candidate_list" model="ir.ui.view">
        <field name="name">golok.lab.research.candidate.list</field>
        <field name="model">golok.lab.research.candidate</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="instrument_id"/><field name="dataset_id"/><field name="observation_at"/>
            <field name="generated_at"/><field name="lifecycle"/><field name="reason"/>
        </list></field>
    </record>
    <record id="view_research_candidate_form" model="ir.ui.view">
        <field name="name">golok.lab.research.candidate.form</field>
        <field name="model">golok.lab.research.candidate</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <sheet>
                <h2>Experimental research</h2>
                <div class="alert alert-warning" role="status">Fixture data · Financial validation unavailable</div>
                <group>
                    <group><field name="instrument_id"/><field name="dataset_id"/><field name="observation_at"/>
                        <field name="generated_at"/><field name="lifecycle"/><field name="reason"/></group>
                    <group><field name="cycle_id"/><field name="engine_version"/><field name="input_digest"/></group>
                </group>
                <notebook>
                    <page string="Levels and Competition"><field name="plan_text" nolabel="1"/></page>
                    <page string="Decision Gates"><field name="gate_text" nolabel="1"/></page>
                    <page string="Research Evidence"><field name="research_text" nolabel="1"/></page>
                </notebook>
            </sheet>
        </form></field>
    </record>
    <record id="action_research_candidates" model="ir.actions.act_window">
        <field name="name">Fixture Candidate Research</field>
        <field name="res_model">golok.lab.research.candidate</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_research_candidates" name="Fixture Candidate Research" parent="menu_lab"
              action="action_research_candidates" sequence="103"/>
    <record id="view_portfolio_performance" model="ir.ui.view">
        <field name="name">golok.lab.portfolio.calculate.performance</field>
        <field name="model">golok.lab.portfolio</field>
        <field name="inherit_id" ref="view_portfolio_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="before">
            <header><button name="action_calculate_performance" type="object" string="Calculate Performance"
                            groups="golok_ai_trading_lab_pro.group_analyst" invisible="contract_fixture or historical_authorized"/></header>
        </xpath></field>
    </record>
    <record id="view_performance_report_list" model="ir.ui.view">
        <field name="name">golok.lab.performance.report.list</field>
        <field name="model">golok.lab.performance.report</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="portfolio_id"/><field name="version"/><field name="status"/><field name="trades"/><field name="expectancy"/>
        </list></field>
    </record>
    <record id="view_performance_report_form" model="ir.ui.view">
        <field name="name">golok.lab.performance.report.form</field>
        <field name="model">golok.lab.performance.report</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <sheet><group><field name="portfolio_id"/><field name="version"/><field name="status"/>
                <field name="trades"/><field name="expectancy"/></group><field name="report" nolabel="1"/></sheet>
        </form></field>
    </record>
    <record id="action_performance_reports" model="ir.actions.act_window">
        <field name="name">Synthetic Strategy Performance</field>
        <field name="res_model">golok.lab.performance.report</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_performance_reports" name="Synthetic Strategy Performance" parent="menu_lab"
              action="action_performance_reports" sequence="104"/>
    <record id="view_fixture_account_list" model="ir.ui.view">
        <field name="name">golok.lab.fixture.account.list</field><field name="model">golok.lab.fixture.account</field>
        <field name="arch" type="xml"><list edit="0" delete="0">
            <field name="name"/><field name="mode"/><field name="state"/><field name="available"/>
            <field name="reserved"/><field name="position_cost"/><field name="realized"/>
        </list></field>
    </record>
    <record id="view_fixture_account_form" model="ir.ui.view">
        <field name="name">golok.lab.fixture.account.form</field><field name="model">golok.lab.fixture.account</field>
        <field name="arch" type="xml"><form edit="0" delete="0" duplicate="0">
            <header>
                <button name="action_reserve_fixture" type="object" string="Reserve Fixture Order" invisible="not id or state != 'active' or watch_ids"
                        groups="golok_ai_trading_lab_pro.group_risk"/>
                <button name="action_open_fixture" type="object" string="Process Fixture Entry" invisible="fixture_stage != 'pending' or watch_ids"
                        groups="golok_ai_trading_lab_pro.group_risk"/>
                <button name="action_close_fixture" type="object" string="Process Fixture Exit" invisible="fixture_stage != 'open' or watch_ids"
                        groups="golok_ai_trading_lab_pro.group_risk"/>
                <button name="action_pause" type="object" string="Pause and Cancel Pending Entries" invisible="not id or state != 'active'"
                        groups="golok_ai_trading_lab_pro.group_risk"/>
                <button name="action_resume" type="object" string="Resume Fixture Account" invisible="not id or state != 'paused'"
                        groups="golok_ai_trading_lab_pro.group_risk"/>
            </header>
            <sheet><field name="fixture_stage" invisible="1"/><group>
                <group><field name="name"/><field name="watch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="scenario" invisible="watch_ids"/>
                    <field name="strategy" invisible="not watch_ids"/><field name="target_policy" invisible="not watch_ids"/>
                    <field name="tariff_id"/>
                    <field name="mode" invisible="not id"/><field name="currency_id" invisible="not id"/>
                    <field name="state" invisible="not id"/><field name="entries" invisible="not id"/></group>
                <group invisible="not id"><field name="opening"/><field name="available"/><field name="reserved"/>
                    <field name="position_cost"/><field name="planned_risk"/><field name="remaining_daily_risk"/>
                    <field name="realized"/><field name="loss_streak"/></group>
            </group><notebook invisible="not id">
                <page string="Orders and Positions"><field name="order_ids" readonly="1"><list>
                    <field name="state"/><field name="quantity"/><field name="entry_observed_at"/>
                    <field name="exit_observed_at"/><field name="exit_reason"/><field name="net"/>
                </list></field></page>
                <page string="Journal (paise)"><field name="journal_ids" readonly="1"><list>
                    <field name="kind"/><field name="user_id"/><field name="delta_cash"/>
                    <field name="cash_after"/><field name="reserved_after"/><field name="position_after"/>
                </list></field></page>
            </notebook></sheet>
        </form></field>
    </record>
    <record id="action_fixture_accounts" model="ir.actions.act_window">
        <field name="name">Prospective Fixture Paper Accounts</field>
        <field name="res_model">golok.lab.fixture.account</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fixture_accounts" name="Prospective Fixture Paper Accounts" parent="menu_lab"
              action="action_fixture_accounts" sequence="105"/>
    <record id="view_fixture_risk_list" model="ir.ui.view">
        <field name="name">golok.lab.fixture.account.risk.list</field><field name="model">golok.lab.fixture.account</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="name"/><field name="state"/><field name="day"/><field name="entries"/>
            <field name="loss_streak"/><field name="planned_risk"/><field name="remaining_daily_risk"/>
        </list></field>
    </record>
    <record id="action_fixture_risk" model="ir.actions.act_window">
        <field name="name">Fixture Risk Monitor</field><field name="res_model">golok.lab.fixture.account</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="view_fixture_risk_list"/>
    </record>
    <menuitem id="menu_fixture_risk" name="Fixture Risk Monitor" parent="menu_lab"
              action="action_fixture_risk" sequence="107" groups="group_risk"/>
    <record id="view_portfolio_walk_experiment" model="ir.ui.view">
        <field name="name">golok.lab.portfolio.wizard.walk.experiment</field>
        <field name="model">golok.lab.portfolio.wizard</field><field name="inherit_id" ref="view_portfolio_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="after"><group string="Walk-forward Session Windows">
                <field name="training_sessions"/><field name="validation_sessions"/><field name="evaluation_sessions"/>
                <field name="embargo_sessions"/><field name="expanding_window"/>
                <field name="calibrate_target" invisible="target_policy != 'causal_levels'"/>
            </group></xpath>
            <xpath expr="//footer/button[@name='action_run']" position="after">
                <button name="action_experiment" type="object" string="Run Walk-forward Experiment"/>
            </xpath>
        </field>
    </record>
    <record id="view_walk_experiment_list" model="ir.ui.view">
        <field name="name">golok.lab.walk.experiment.list</field><field name="model">golok.lab.walk.experiment</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="fingerprint"/><field name="version"/><field name="fold_count"/>
        </list></field>
    </record>
    <record id="view_walk_experiment_form" model="ir.ui.view">
        <field name="name">golok.lab.walk.experiment.form</field><field name="model">golok.lab.walk.experiment</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><header>
            <button name="action_review_promotion" type="object" string="Review Promotion Evidence"
                    groups="golok_ai_trading_lab_pro.group_risk"/>
        </header>
            <sheet><group><field name="fingerprint"/><field name="version"/><field name="fold_count"/></group>
                <field name="report" nolabel="1"/></sheet>
        </form></field>
    </record>
    <record id="action_walk_experiments" model="ir.actions.act_window">
        <field name="name">Synthetic Walk-forward Experiments</field>
        <field name="res_model">golok.lab.walk.experiment</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_walk_experiments" name="Synthetic Walk-forward Experiments" parent="menu_lab"
              action="action_walk_experiments" sequence="106"/>
    <record id="view_promotion_review" model="ir.ui.view">
        <field name="name">golok.lab.promotion.review.form</field><field name="model">golok.lab.promotion.review</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet>
            <group><field name="experiment_id"/><field name="reviewed_by"/><field name="frozen_sha256"/></group>
            <field name="evidence_text" nolabel="1"/>
        </sheet></form></field>
    </record>
</odoo>
