<odoo>
    <record id="instrument_company" model="ir.rule">
        <field name="name">Lab instrument company</field>
        <field name="model_id" ref="model_golok_lab_instrument"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dataset_company" model="ir.rule">
        <field name="name">Lab dataset company</field>
        <field name="model_id" ref="model_golok_lab_dataset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="candle_company" model="ir.rule">
        <field name="name">Lab candle company</field>
        <field name="model_id" ref="model_golok_lab_candle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="run_company" model="ir.rule">
        <field name="name">Lab research company</field>
        <field name="model_id" ref="model_golok_lab_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
