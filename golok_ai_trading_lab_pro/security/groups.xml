<odoo>
    <record id="category_lab" model="ir.module.category">
        <field name="name">Golok Technology</field>
    </record>
    <record id="privilege_lab" model="res.groups.privilege">
        <field name="name">Trading Lab</field>
        <field name="category_id" ref="category_lab"/>
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="name">Trading Research Viewer</field>
        <field name="privilege_id" ref="privilege_lab"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_analyst" model="res.groups">
        <field name="name">Trading Research Analyst</field>
        <field name="privilege_id" ref="privilege_lab"/>
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
    </record>
    <record id="group_risk" model="res.groups">
        <field name="name">Trading Risk Manager</field>
        <field name="privilege_id" ref="privilege_lab"/>
        <field name="implied_ids" eval="[(4, ref('group_analyst'))]"/>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">Trading System Administrator</field>
        <field name="privilege_id" ref="privilege_lab"/>
        <field name="implied_ids" eval="[(4, ref('group_risk'))]"/>
    </record>
</odoo>
