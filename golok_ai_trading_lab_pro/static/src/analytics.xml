<templates xml:space="preserve">
    <t t-name="golok_ai_trading_lab_pro.AnalyticsCredential">
        <div class="o_action overflow-auto p-4">
            <h1>Upstox Analytics Credential</h1>
            <p t-if="this.state.stored">A credential is stored for this company.</p>
            <p t-if="this.state.connection">Connection check <strong t-esc="this.state.connection"/></p>
            <form method="post" t-on-submit="this.save" class="d-flex flex-column gap-3" style="max-width: 30rem">
                <label>Analytics Token
                    <input class="form-control" type="password" name="credential" autocomplete="new-password" maxlength="4096" required="required"/>
                </label>
                <label>Expiry with time zone
                    <input class="form-control" type="text" name="expiry" placeholder="YYYY-MM-DDThh:mm:ss+05:30" maxlength="32" required="required"/>
                </label>
                <button class="btn btn-primary align-self-start" type="submit"
                        t-att-disabled="this.state.loading || !this.csrf">Save and Test Connection</button>
            </form>
            <p class="mt-3" role="status" t-esc="this.state.banner"/>
        </div>
    </t>
</templates>
